@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <div class="text-center bg-light rounded-4 shadow-sm p-5">
        <h1 class="display-4 fw-bold mb-3">Welcome to EventEase</h1>
        <p class="lead mb-4">Manage venues, events, and customer bookings from one simple dashboard.</p>
        <p class="text-muted mb-4">Use the navigation menu to create bookings, view venue availability, and manage upcoming events efficiently.</p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Venues" asp-action="Index" class="btn btn-primary btn-lg">Manage Venues</a>
            <a asp-controller="Events" asp-action="Index" class="btn btn-success btn-lg">Manage Events</a>
            <a asp-controller="Bookings" asp-action="Index" class="btn btn-dark btn-lg">View Bookings</a>
        </div>
    </div>

    <div class="row text-center mt-5 g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="card-title">Venue Management</h5>
                    <p class="card-text">Add new venues, update details, and track capacity and locations.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="card-title">Event Scheduling</h5>
                    <p class="card-text">Organise events with clear start and end dates for smooth planning.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="card-title">Booking Control</h5>
                    <p class="card-text">Create and manage customer bookings while reducing conflicts.</p>
                </div>
            </div>
        </div>
    </div>
</div>